<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        app:key="updateTagQ"
        app:title="@string/pref_update_tag_title"
        app:summary="@string/pref_update_tag_summary"
        app:defaultValue="true"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        app:key="nickname"
        app:title="@string/pref_nickname_title"
        app:dialogTitle="@string/pref_nickname_dialog_title"
        app:dialogMessage="@string/pref_nickname_dialog_message"
        app:defaultValue="anonymous"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
