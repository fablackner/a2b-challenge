<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="#FFFFFF"
    tools:context=".ui.InitialBottomFragment">

    <ImageButton
        android:id="@+id/menuIB"
        android:layout_width="63dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="?android:selectableItemBackground"
        android:onClick="showMenu"
        app:layout_constraintBottom_toBottomOf="@+id/newrunIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/newrunIV"
        app:srcCompat="@drawable/menu" />

    <ImageView
        android:id="@+id/newrunIV"
        android:layout_width="263dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        android:background="?android:selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/scanning" />

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/introgif"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/intro"
        app:layout_constraintBottom_toTopOf="@+id/newrunIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>