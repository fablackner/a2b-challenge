<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    tools:context=".ui.InitialBottomFragment">

    <ImageView
        android:id="@+id/recordItemFrameIV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        android:background="?android:selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/my_records_frame" />

    <TextView
        android:id="@+id/recordItemNameTV"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="120dp"
        android:ems="9"
        android:fontFamily="sans-serif-condensed-medium"
        android:textAllCaps="false"
        android:textColor="#720646"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/recordItemFrameIV"
        app:layout_constraintEnd_toEndOf="@+id/recordItemFrameIV"
        app:layout_constraintHorizontal_bias="0.78"
        app:layout_constraintStart_toStartOf="@+id/recordItemFrameIV"
        app:layout_constraintTop_toTopOf="@+id/recordItemFrameIV"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/myRankIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:src="@drawable/first_place_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/recordItemFrameIV"
        app:layout_constraintStart_toStartOf="@+id/recordItemFrameIV" />

</androidx.constraintlayout.widget.ConstraintLayout>