<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.InfoFragment"
    android:background="@drawable/background">

    <ImageButton
        android:id="@+id/newrunIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:background="?android:selectableItemBackground"
        app:layout_constraintStart_toStartOf="@+id/informationIV"
        app:layout_constraintTop_toBottomOf="@+id/informationIV"
        app:srcCompat="@drawable/scan_start_tag" />

    <ImageView
        android:id="@+id/informationIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/information" />

    <TextView
        android:id="@+id/descriptionTV"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="10dp"
        android:ems="8"
        android:fontFamily="sans-serif-condensed-medium"
        android:justificationMode="inter_word"
        android:lineHeight="18dp"
        android:textAllCaps="false"
        android:textColor="#720646"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/informationIV"
        app:layout_constraintStart_toStartOf="@+id/informationIV"
        app:layout_constraintTop_toTopOf="@+id/informationIV" />

    <!--android:justificationMode="inter_word"-->

    <TextView
        android:id="@+id/trackNameTV"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:ems="9"
        android:fontFamily="sans-serif-condensed-medium"
        android:textAllCaps="false"
        android:textColor="#720646"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/informationIV"
        app:layout_constraintHorizontal_bias="0.78"
        app:layout_constraintStart_toStartOf="@+id/informationIV"
        app:layout_constraintTop_toTopOf="@+id/informationIV" />

    <TextView
        android:id="@+id/horizontalDistanceTV"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="78dp"
        android:layout_marginTop="51dp"
        android:layout_marginEnd="215dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:gravity="end"
        android:textAllCaps="false"
        android:textColor="#720646"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/informationIV"
        app:layout_constraintHorizontal_bias="0.28"
        app:layout_constraintStart_toStartOf="@+id/informationIV"
        app:layout_constraintTop_toTopOf="@+id/informationIV" />

    <TextView
        android:id="@+id/verticalDistanceTV"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="220dp"
        android:layout_marginTop="51dp"
        android:layout_marginEnd="74dp"
        android:ems="9"
        android:fontFamily="sans-serif-condensed-medium"
        android:gravity="end"
        android:textAllCaps="false"
        android:textColor="#720646"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/informationIV"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="@+id/informationIV"
        app:layout_constraintTop_toTopOf="@+id/informationIV" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:src="@drawable/starting_position"
        app:layout_constraintBottom_toBottomOf="@+id/newrunIV"
        app:layout_constraintEnd_toEndOf="@+id/informationIV"
        app:layout_constraintTop_toTopOf="@+id/newrunIV" />


</androidx.constraintlayout.widget.ConstraintLayout>