<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.TimerFragment"
    android:background="@drawable/background">

    <ImageView
        android:id="@+id/newrunIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:selectableItemBackground"
        app:layout_constraintStart_toStartOf="@+id/stopWatchIV"
        app:layout_constraintTop_toBottomOf="@+id/stopWatchIV"
        app:srcCompat="@drawable/scan_finish_tag" />

    <ImageView
        android:id="@+id/stopWatchIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/stop_watch" />

    <TextView
        android:id="@+id/clockTV"
        android:layout_width="259dp"
        android:layout_height="34dp"
        android:layout_marginStart="32dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="53dp"
        android:layout_marginEnd="32dp"
        android:layout_marginRight="32dp"
        android:gravity="center"
        android:lineSpacingExtra="8sp"
        android:text="-- min -- sec"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#FFEF68"
        android:textSize="30sp"
        android:textStyle="bold"
        android:typeface="normal"
        app:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="@+id/stopWatchIV"
        app:layout_constraintEnd_toEndOf="@+id/stopWatchIV"
        app:layout_constraintStart_toStartOf="@+id/stopWatchIV"
        app:layout_constraintTop_toTopOf="@+id/stopWatchIV" />

    <ImageView
        android:id="@+id/runnerIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/running_position2"
        app:layout_constraintBottom_toBottomOf="@+id/newrunIV"
        app:layout_constraintEnd_toEndOf="@+id/stopWatchIV"
        app:layout_constraintTop_toTopOf="@+id/newrunIV" />


</androidx.constraintlayout.widget.ConstraintLayout>